for trial in range(num_trials):
    if (trial + 1) % 25 == 0:
        print(f"  Progress: {trial + 1}/{num_trials}")
    
    # Add noise
    range_noise = np.random.randn(len(ranges)) * 0.3
    angle_noise = np.random.randn(len(angles)) * np.deg2rad(5)
    
    noisy_ranges = ranges + range_noise
    noisy_angles = angles + angle_noise
    
    # Hybrid method
    pos_hybrid = solver.hybrid_localization(
        anchor_pos_array, noisy_ranges, noisy_angles
    )
    errors_hybrid.append(np.linalg.norm(pos_hybrid - target_position))
    
    # Range-only method
    def range_only_objective(pos):
        estimated_ranges = np.linalg.norm(anchor_pos_array - pos, axis=1)
        return np.sum((noisy_ranges - estimated_ranges)**2)
    
    result = minimize(range_only_objective, np.mean(anchor_pos_array, axis=0))
    errors_range_only.append(np.linalg.norm(result.x - target_position))

errors_hybrid = np.array(errors_hybrid)
errors_range_only = np.array(errors_range_only)


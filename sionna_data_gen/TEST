# ============================================================================
# CSI ANGLE ESTIMATOR (MUSIC Algorithm)
# ============================================================================

class CSIAngleEstimator:
    """Angle of Arrival estimator using MUSIC algorithm"""
    
    def __init__(self, num_antennas, wavelength):
        self.num_antennas = num_antennas
        self.wavelength = wavelength
        self.antenna_spacing = wavelength / 2
        self.k = 2 * np.pi / wavelength
    
    def steering_vector(self, angle):
        """Compute steering vector for given angle"""
        positions = np.arange(self.num_antennas) * self.antenna_spacing
        return np.exp(1j * self.k * positions * np.sin(angle))
    
    def estimate_aoa_music(self, csi_matrix, num_sources=1):
        """MUSIC algorithm for AoA estimation"""
        # Average across subcarriers
        avg_csi = np.mean(csi_matrix, axis=1)
        
        # Covariance matrix
        R = np.outer(avg_csi, avg_csi.conj())
        
        # Eigendecomposition
        eigenvalues, eigenvectors = np.linalg.eigh(R)
        idx = eigenvalues.argsort()[::-1]
        
        # Noise subspace
        noise_subspace = eigenvectors[:, idx[num_sources:]]
        
        # Angular search
        angles = np.linspace(-np.pi/2, np.pi/2, 180)
        spectrum = np.zeros(len(angles))
        
        for i, angle in enumerate(angles):
            a = self.steering_vector(angle)
            spectrum[i] = 1.0 / (np.abs(
                a.conj() @ noise_subspace @ noise_subspace.conj().T @ a
            ) + 1e-10)
        
        # Find peak
        peak_idx = np.argmax(spectrum)
        return angles[peak_idx], (angles, spectrum)

print("✓ AoA Estimator defined")


# ============================================================================
# FTM RANGE ESTIMATOR
# ============================================================================

class FTMRangeEstimator:
    """Range estimator from CSI phase slope"""
    
    def __init__(self, speed_of_light=3e8):
        self.c = speed_of_light
    
    def estimate_range_from_phase(self, csi, subcarrier_spacing):
        """Estimate range from phase slope across subcarriers"""
        phase = np.unwrap(np.angle(csi))
        subcarrier_idx = np.arange(len(phase))
        
        # Linear regression
        coeffs = np.polyfit(subcarrier_idx * subcarrier_spacing, phase, 1)
        phase_slope = coeffs[0]
        
        # Convert to range
        toa = -phase_slope / (2 * np.pi)
        return abs(self.c * toa / 2)

print("✓ Range Estimator defined")


# ============================================================================
# BILATERATION SOLVER
# ============================================================================

class BilaterationSolver:
    """Hybrid bilateration using range and angle"""
    
    @staticmethod
    def hybrid_localization(anchor_positions, ranges, angles, 
                           distance_std=0.5, angle_std=0.1):
        """Weighted hybrid bilateration"""
        num_anchors = len(anchor_positions)
        
        # Weights
        distance_weight = 1 / (distance_std**2)
        angle_weight = 1 / (angle_std**2)
        
        def objective(pos):
            error = 0
            
            # Distance errors
            for i in range(num_anchors):
                estimated_dist = np.linalg.norm(pos - anchor_positions[i])
                error += distance_weight * (ranges[i] - estimated_dist)**2
            
            # Angle errors
            for i in range(num_anchors):
                if not np.isnan(angles[i]):
                    direction = pos[:2] - anchor_positions[i, :2]
                    estimated_angle = np.arctan2(direction[1], direction[0])
                    angle_diff = angles[i] - estimated_angle
                    angle_diff = np.arctan2(np.sin(angle_diff), np.cos(angle_diff))
                    error += angle_weight * angle_diff**2
            
            return error
        
        # Initial guess
        x0 = np.mean(anchor_positions, axis=0)
        
        # Optimize
        result = minimize(objective, x0, method='BFGS')
        return result.x

print("✓ Bilateration Solver defined")


# ============================================================================
# CSI GENERATOR (Realistic Synthetic)
# ============================================================================

def generate_realistic_csi(ap_position, target_position, num_antennas, 
                          num_subcarriers, carrier_freq, subcarrier_spacing,
                          wavelength, snr_db=20):
    """
    Generate realistic CSI with multipath
    """
    # Calculate true parameters
    true_range = np.linalg.norm(np.array(target_position) - np.array(ap_position))
    direction = np.array(target_position[:2]) - np.array(ap_position[:2])
    true_angle = np.arctan2(direction[1], direction[0])
    
    # Generate CSI matrix
    csi_matrix = np.zeros((num_antennas, num_subcarriers), dtype=complex)
    
    # Simulate multipath (direct path + 2 reflections)
    num_paths = 3
    path_gains = np.array([1.0, 0.3, 0.2])  # Relative amplitudes
    path_delays = np.array([0, 5e-9, 15e-9])  # Time delays in seconds
    path_angles = np.array([true_angle, true_angle + 0.2, true_angle - 0.3])
    
    for ant_idx in range(num_antennas):
        for sub_idx in range(num_subcarriers):
            freq = carrier_freq + (sub_idx - num_subcarriers/2) * subcarrier_spacing
            
            # Sum all paths
            h = 0
            for path_idx in range(num_paths):
                # Antenna phase shift based on AoA
                k = 2 * np.pi / wavelength
                ant_phase = k * (ant_idx * wavelength/2) * np.sin(path_angles[path_idx])
                
                # Frequency-dependent phase from delay
                delay_phase = -2 * np.pi * freq * (true_range / 3e8 + path_delays[path_idx])
                
                # Combined response with path loss
                amplitude = path_gains[path_idx] / (true_range + 0.1)
                h += amplitude * np.exp(1j * (delay_phase + ant_phase))
            
            csi_matrix[ant_idx, sub_idx] = h
    
    # Add noise
    signal_power = np.mean(np.abs(csi_matrix)**2)
    noise_power = signal_power * 10**(-snr_db/10)
    noise = np.sqrt(noise_power/2) * (
        np.random.randn(*csi_matrix.shape) + 
        1j * np.random.randn(*csi_matrix.shape)
    )
    csi_matrix += noise
    
    return csi_matrix, true_range, true_angle

print("✓ CSI Generator defined")


